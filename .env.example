# Every variable is optional: the values below are the defaults the app uses when a variable
# is not set or is empty. Full descriptions: docs/env.md
#
# Durations use Go syntax: 500ms, 15s, 2m, 1h30m. A plain number without a unit is invalid.

# --- HTTP server ---
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# --- Shutdown ---
SHUTDOWN_TIMEOUT=20s

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json | text  (text is easier to read in a terminal)
LOG_FORMAT=json
