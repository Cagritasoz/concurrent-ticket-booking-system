# Copy this file to .env and change the values. Full descriptions: docs/open/07-configuration.md
#
# Durations use Go syntax: 500ms, 15s, 2m, 1h30m. A plain number without a unit is invalid.

# --- Database ---
# Read by Docker Compose to create the Postgres container. All are required by Compose, except
# POSTGRES_PORT.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database
POSTGRES_PORT=5432

# Read by the app. Required, there is no default. It must match the values above; special characters
# in the password must be percent-encoded (@ becomes %40). sslmode=disable is for local use only.
DATABASE_URL=postgres://user:password@localhost:5432/database?sslmode=disable

# The variables below are optional: these values are the defaults the app uses when a variable is
# not set or is empty.

# --- HTTP server ---
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# --- Shutdown ---
SHUTDOWN_TIMEOUT=20s

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json | text  (text is easier to read in a terminal)
LOG_FORMAT=json
